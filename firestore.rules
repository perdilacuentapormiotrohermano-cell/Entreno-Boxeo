rules_version = '2';

// Reglas de Firestore para el ranking de Coach Boxeo.
// Pegalas en: Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /ranking/{entry} {
      // Cualquiera puede ver el ranking.
      allow read: if true;

      // Solo se pueden CREAR registros (no editar ni borrar), con sesión anónima
      // y con valores dentro de límites razonables.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'avatar', 'group', 'mode', 'level', 'rounds', 'workSeconds', 'points', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.group is string
        && request.resource.data.group.size() <= 20
        && request.resource.data.group.matches('^[a-z0-9-]*$')
        && request.resource.data.mode in ['normal', 'sparring', 'intensity']
        && request.resource.data.level in [1, 2, 3]
        && request.resource.data.rounds is int
        && request.resource.data.rounds >= 1 && request.resource.data.rounds <= 200
        && request.resource.data.workSeconds is int
        && request.resource.data.workSeconds >= 10 && request.resource.data.workSeconds <= 40000
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        // máximo posible: (10 pts/min + 20 pts/round) × 1,95
        && request.resource.data.points <=
             ((request.resource.data.workSeconds * 10 / 60) + (request.resource.data.rounds * 20)) * 2
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
